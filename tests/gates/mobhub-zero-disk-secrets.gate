# tests/gates/mobhub-zero-disk-secrets.gate
# Always-run: no .env files may live on disk in the repository (phase 3 invariant
# carried over from the removed hosted job "Enforce Zero Disk Secrets Invariant").
gate: MOBHUB-ZERO-DISK-SECRETS
manifest_version: 2
owner: mobhub
requires:
  - portable
inputs:
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["zero-disk-secrets"]
expects:
  exit: 0
  observe: ["env_files_found == false"]
  verdict: PASS
timeout: 2m
exactness: EXACT
cache_scope: portable
