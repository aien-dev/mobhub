# tests/gates/mobhub-test.gate
gate: MOBHUB-TEST
manifest_version: 2
owner: mobhub
requires:
  - host
inputs:
  - Cargo.toml
  - Cargo.lock
  - src/
  - tests/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["test"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine
