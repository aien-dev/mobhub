# tests/gates/mobhub-clippy.gate
gate: MOBHUB-CLIPPY
manifest_version: 2
owner: mobhub
requires:
  - host
inputs:
  - Cargo.toml
  - Cargo.lock
  - src/
  - tests/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["clippy"]
expects:
  exit: 0
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine
